# ---------- Database (Neon Postgres) ----------
# Neon console > your project > "Connect" button > pick the POOLED connection string. Paste it here.
# Format: postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# ---------- Auth ----------
# Any long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---------- Admin dashboard ----------
# Emails of the people allowed into /admin, separated by commas. They sign up normally first.
# Example: ADMIN_EMAILS=you@yourdomain.com,partner@yourdomain.com
ADMIN_EMAILS=

# ---------- AI (Groq free tier by default) ----------
# Get a free key at https://console.groq.com/keys
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
# Max AI calls per user per hour (protects your free quota).
AI_HOURLY_LIMIT=20
# Credits new users get on sign up.
FREE_CREDITS=20

# ---------- Email (optional, Resend free tier) ----------
# Leave empty to skip emails. In-app notifications still work.
RESEND_API_KEY=
EMAIL_FROM=Formtified <notifications@yourdomain.com>

# ---------- App ----------
# Your public URL (used in email links). Locally: http://localhost:3000
APP_URL=http://localhost:3000
# Where people can reach you (footer, legal pages, help). Defaults to support@weblanda.com.
CONTACT_EMAIL=

# ---------- File uploads (optional, Vercel Blob) ----------
# Vercel > your project > Storage > Create > Blob > connect it to the project. Vercel adds this for you.
# To test uploads locally, copy the token from the Blob store's settings (".env.local" tab).
# Leave empty and file questions show "uploads aren't available" and never block a form.
BLOB_READ_WRITE_TOKEN=

# ---------- Payments (optional, Paystack) ----------
# Paystack dashboard > Settings > API Keys & Webhooks. Use the TEST secret key (sk_test_...) until you're ready.
# Also set the Webhook URL there to: https://yourdomain.com/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# ---------- Daily clean-up ----------
# Any long random string. Vercel sends it to /api/cron/cleanup once a day to delete abandoned uploads.
CRON_SECRET=
